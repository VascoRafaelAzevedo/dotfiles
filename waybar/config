// ### BOT i3-Minimal — clean i3bar-style bottom bar ###

{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/UserModules"
  ],
"layer": "top",
"position": "bottom",
"exclusive": true,
"passthrough": false,
"gtk-layer-shell": true,

"hyprland/workspaces#i3": {
  "active-only": false,
  "all-outputs": false,
  "format": "{name}",
  "show-special": false,
  "on-click": "activate",
  "on-scroll-up": "hyprctl dispatch workspace e+1",
  "on-scroll-down": "hyprctl dispatch workspace e-1",
  "sort-by-number": true,
  "persistent-workspaces": {
    "eDP-2":    [1, 3, 5, 7, 9],
    "HDMI-A-1": [2, 4, 6, 8, 10]
  }
},

"modules-left": [
  "hyprland/workspaces#i3"
  ],

"modules-center": [
  "clock"
  ],

"modules-right": [
  "memory",
  "temperature",
  "pulseaudio",
  "network",
  "battery",
  "power-profiles-daemon",
  "custom/power"
  ]
}
